{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inkwell",
  "version": "0.1.0",
  "identifier": "com.fizzexual.inkwell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Inkwell",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "font-src": "'self' data:",
        "media-src": "'self' blob: data:",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data: https://api.groq.com https://api.cerebras.ai https://generativelanguage.googleapis.com https://api.mistral.ai https://openrouter.ai http://localhost:11434 http://127.0.0.1:11434 https://api.anthropic.com https://api.openai.com https://api.deepseek.com https://api.x.ai https://api.together.xyz https://api.perplexity.ai https://api.crossref.org https://export.arxiv.org",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
